          "docs": "Get Company By Identifiers"
        },
        {
          "info": {
            "name": "Get Person By Canonical",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/persons",
            "params": [
              {
                "name": "linkedin_url",
                "value": "https://www.linkedin.com/in/elonmusk",
                "type": "query",
                "description": "Linkedin profile URL."
              },
              {
                "name": "email",
                "value": "john.doe@example.com",
                "type": "query",
                "description": "Email address for person lookup. Used as fallback when linkedin_url is not provided or yields no result."
              }
            ]
          },
          "docs": "Get Person By Canonical"
        },
        {

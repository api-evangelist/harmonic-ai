                "type": "query",
                "description": "Company LinkedIn profile URL."
              },
              {
                "name": "website_url",
                "value": "https://www.harmonic.ai",
                "type": "query",
                "description": "Company website URL."
              },
              {
                "name": "twitter_url",
                "value": "twitter.com/facebook",
                "type": "query",
                "description": "Company twitter URL."
              },
              {
                "name": "crunchbase_url",

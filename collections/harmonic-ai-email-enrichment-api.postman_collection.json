          "name": "Submit Job",
          "request": {
            "name": "Submit Job",
            "description": {
              "content": "Submit a bulk email enrichment job.\n\nAccepts exactly one of `person_linkedin_urls` or `person_urns`.\nReturns 202 with the created job_id and a list of any people that\nwere dropped at submit time (with reasons). Returns 422 when no\nsubmitted people are eligible for enrichment, and 429 when the\nrequest requires more enrichment credits than remain in your monthly\nquota.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "email_enrichment",
                "jobs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
